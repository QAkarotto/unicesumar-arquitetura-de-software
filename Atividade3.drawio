          <mxGeometry height="50" width="160" x="260" y="260" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="f1" style="html=1;fontSize=11;endArrow=block;strokeColor=#B85450;fontColor=#B85450;" target="db1" value="Acesso direto ao banco (SQL)">
          <mxGeometry relative="1" x="0.4637" y="-72" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="f1" style="html=1;fontSize=11;endArrow=block;strokeColor=#B85450;fontColor=#B85450;" target="pp1" value="Integracao direta / credenciais no cliente">
          <mxGeometry relative="1" x="0.7278" y="94" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="exp1" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#fff5f5;strokeColor=#B85450;rounded=1;spacingTop=13;spacingRight=0;spacingLeft=15;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;Por que e inadequado:&lt;br&gt;- Expoe credenciais e logica de acesso a dados no cliente&lt;br&gt;- Frontend passa a depender da estrutura interna do banco&lt;br&gt;- Sem camada central de validacao, regras de negocio e seguranca&lt;br&gt;- Chaves/segredos de integracoes (ex.: PayPal) ficam expostos no navegador&lt;br&gt;- Dificulta versionamento, testes e escalabilidade&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" value="Frontend&#xa;(React / TypeScript)" vertex="1">
          <mxGeometry height="50" width="160" x="660" y="80" as="geometry" />
        </mxCell>
        <mxCell id="be2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" value="Backend / API&#xa;(Java / Spring Boot)" vertex="1">
          <mxGeometry height="50" width="160" x="660" y="180" as="geometry" />
        </mxCell>
        <mxCell id="db2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" value="Banco de Dados&#xa;(PostgreSQL)" vertex="1">
          <mxGeometry height="50" width="160" x="560" y="290" as="geometry" />
        </mxCell>
        <mxCell id="pp2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" value="PayPal&#xa;(API externa)" vertex="1">
          <mxGeometry height="50" width="160" x="760" y="290" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="f2" style="html=1;fontSize=11;endArrow=block;strokeColor=#82B366;fontColor=#82B366;" target="be2" value="REST / HTTPS / JSON">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="be2" style="html=1;fontSize=11;endArrow=block;strokeColor=#82B366;fontColor=#82B366;" target="db2" value="JDBC / SQL (acesso interno)">
          <mxGeometry relative="1" x="1" y="-61" as="geometry">
