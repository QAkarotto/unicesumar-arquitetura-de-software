          </mxGeometry>
        </mxCell>
        <mxCell id="exp2" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5fff5;strokeColor=#82B366;rounded=1;spacingTop=17;spacingLeft=8;" value="O backend concentra o acesso a dados e as integracoes externas, expondo ao frontend apenas uma API REST simples. Cada camada mantem uma unica responsabilidade (frontend = interface, backend = regras de negocio, dados e integracoes)." vertex="1">
          <mxGeometry height="110" width="360" x="560" y="390" as="geometry" />
        </mxCell>
