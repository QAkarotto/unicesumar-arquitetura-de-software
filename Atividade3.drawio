        <mxCell id="m3" edge="1" parent="1" style="html=1;fontSize=11;align=center;verticalAlign=bottom;endArrow=block;strokeColor=#000000;" value="3. GET /api/restaurants?latitude=-25.095&amp;longitude=-50.161&#xa;Accept: application/json  (HTTPS)">
