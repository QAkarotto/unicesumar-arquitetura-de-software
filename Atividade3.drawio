        <mxCell id="m2" edge="1" parent="1" style="html=1;fontSize=11;align=center;verticalAlign=top;endArrow=block;strokeColor=#000000;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;2. Captura latitude/longitude do dispositivo (GPS)&lt;/font&gt;">
          <mxGeometry relative="1" x="-0.2727" y="20" as="geometry">
