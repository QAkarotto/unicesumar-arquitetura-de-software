        </mxCell>
        <mxCell id="f1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" value="Frontend&#xa;(React / TypeScript)" vertex="1">
          <mxGeometry height="50" width="160" x="140" y="80" as="geometry" />
        </mxCell>
        <mxCell id="db1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" value="Banco de Dados&#xa;(PostgreSQL)" vertex="1">
