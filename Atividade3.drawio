  <diagram id="arch-comparison" name="Arquitetura Inadequada vs Corrigida">
    <mxGraphModel dx="679" dy="409" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#B85450;align=left;verticalAlign=middle;" value="Arquitetura Inadequada" vertex="1">
          <mxGeometry height="30" width="180" x="140" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#82B366;align=left;verticalAlign=middle;" value="Arquitetura Corrigida" vertex="1">
