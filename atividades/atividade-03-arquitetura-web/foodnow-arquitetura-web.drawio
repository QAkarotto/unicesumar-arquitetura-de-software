        <mxCell id="x1" value="✕" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=2;fontColor=#C0392B;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="527" y="387" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="ar2" value="REST / HTTPS / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2E7D46;strokeWidth=1.8;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#2E7D46;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ar3" value="JDBC / SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2E7D46;strokeWidth=1.8;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#2E7D46;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ar4" value="REST / HTTPS / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2E7D46;strokeWidth=1.8;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#2E7D46;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b2" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="nb#C0392B" value="O frontend roda no navegador do usuário: qualquer pessoa consegue ler o código,&lt;br&gt;inspecionar a rede e extrair a senha do banco e a chave do PayPal.&lt;br&gt;Além disso, a regra de negócio fica duplicada em cada cliente e o banco&lt;br&gt;passa a aceitar conexões vindas da internet." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=1.2;fontSize=10.5;fontColor=#334155;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="660" height="80" as="geometry"/></mxCell>
        <mxCell id="nb#2E7D46" value="O frontend só conversa com a API REST do backend, por HTTPS e JSON.&lt;br&gt;As credenciais do banco e do PayPal ficam no servidor, a regra de negócio&lt;br&gt;fica em um lugar só e vale para todos os clientes, e o PostgreSQL&lt;br&gt;só aceita conexões vindas do backend." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D46;strokeWidth=1.2;fontSize=10.5;fontColor=#334155;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="700" width="660" height="80" as="geometry"/></mxCell>
      </root></mxGraphModel>
  </diagram>
