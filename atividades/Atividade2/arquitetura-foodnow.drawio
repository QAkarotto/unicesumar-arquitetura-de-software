        </mxCell>
        <mxCell id="n50" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8B71A;strokeColor=none;fontColor=#4A3B00;fontSize=12;fontStyle=1;" value="PayPal&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;integra&amp;#231;&amp;#227;o externa&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="190" x="880" y="360" as="geometry" />
        </mxCell>
        <mxCell id="n51" edge="1" parent="1" source="n46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=0;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" target="n47" value="usa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n52" edge="1" parent="1" source="n47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=0;strokeColor=#7A9A3C;fontSize=11;labelBackgroundColor=#FFFFFF;" target="n48" value="REST / HTTPS / JSON&lt;br&gt;GET /api/restaurants">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n53" edge="1" parent="1" source="n48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=0;strokeColor=#E67E22;fontSize=11;labelBackgroundColor=#FFFFFF;" target="n49" value="SQL via JPA / JDBC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n54" edge="1" parent="1" source="n48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=0;strokeColor=#B58B00;fontSize=11;labelBackgroundColor=#FFFFFF;" target="n50" value="chamada autenticada&lt;br&gt;chave guardada no servidor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n55" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontSize=10;dashed=1;" value="n&amp;#227;o conhece o&lt;br&gt;esquema do banco" vertex="1">
          <mxGeometry height="46" width="190" x="300" y="390" as="geometry" />
        </mxCell>
        <mxCell id="n56" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F8EC;strokeColor=#7A9A3C;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;O que muda:&lt;/b&gt;&lt;br&gt;&lt;br&gt;O frontend passa a conversar com um único ponto: a API.&amp;nbsp;&lt;div&gt;Envia latitude e longitude, recebe JSON e cuida apenas de apresentar o resultado. Não sabe qual banco existe do outro lado, nem quais tabelas foram consultadas.&lt;br&gt;&lt;br&gt;O servidor fica responsável por autenticar a requisição, validar os parâmetros, aplicar as regras de negócio, consultar o PostgreSQL em rede interna e acionar a PayPal com credenciais que nunca saem do servidor. Se o esquema do banco mudar ou o gateway de pagamento for substituído, o contrato da API permanece o mesmo e o frontend não precisa ser alterado.&lt;/div&gt;" vertex="1">
          <mxGeometry height="127" width="1010" x="60" y="500" as="geometry" />
        </mxCell>
        <mxCell id="s-T_Gdg6A_Q95sW1gdfp-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4F2;strokeColor=#B85450;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Por que a outra organização é inadequada:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Credenciais expostas.&lt;/b&gt; O frontend roda na máquina do usuário. Usuário e senha do banco, assim como a chave da PayPal, ficariam visíveis no código-fonte, no tráfego de rede ou nas ferramentas de desenvolvedor do navegador.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Banco exposto na internet.&lt;/b&gt; Para o navegador alcançar o PostgreSQL, o banco precisaria aceitar conexões públicas, ampliando muito a superfície de ataque.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Validação sem confiabilidade.&lt;/b&gt; Qualquer regra escrita no cliente pode ser alterada pelo usuário. Valores de pedido, descontos e permissões deixariam de ser confiáveis.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Acoplamento ao esquema do banco.&lt;/b&gt; A interface passaria a depender de tabelas e colunas; renomear uma coluna quebraria a aplicação." vertex="1">
          <mxGeometry height="166" width="1010" x="60" y="640" as="geometry" />
        </mxCell>
        <mxCell id="ZAGNCX0thj8dwDwXs1hA-1" parent="1" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=https://upload.wikimedia.org/wikipedia/commons/thumb/a/a7/React-icon.svg/3840px-React-icon.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail;" value="" vertex="1">
          <mxGeometry height="34" width="38.18" x="349.41" y="196" as="geometry" />
        </mxCell>
        <mxCell id="ZAGNCX0thj8dwDwXs1hA-2" parent="1" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTORwzeZE9nF8t0F2Jqkji8IMTx8ghkSZGX-zehgXLOaw&amp;s=10;" value="" vertex="1">
