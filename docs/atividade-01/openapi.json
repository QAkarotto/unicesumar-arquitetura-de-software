{
  "openapi": "3.0.3",
  "info": {
    "title": "FoodNow — operações de pedidos",
    "version": "1.1.0",
    "description": "Contrato evoluído: observação opcional somente na criação, preservada nas quatro respostas de pedido. Ausência ou null não acrescenta campo ao JSON (configuração non_null existente). Texto vazio e espaços são preservados; não há edição posterior."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/pedidos": {
      "post": {
        "operationId": "criarPedido",
        "summary": "Criar pedido com itens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoRequest"
              },
              "example": {
                "clienteId": 1,
                "restauranteId": 1,
                "enderecoEntregaId": 1,
                "itens": [
                  {
                    "produtoId": 1,
                    "quantidade": 2
                  }
                ],
                "observacao": "Não incluir talheres"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido criado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PedidoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "422": {
            "$ref": "#/components/responses/Erro422"
          }
        }
      }
    },
    "/pedidos/{id}": {
      "get": {
        "operationId": "consultarPedido",
        "summary": "Consultar pedido",
        "responses": {
          "200": {
            "description": "Representação atual do pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PedidoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador do pedido, convertido para Long.",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ]
    },
    "/pedidos/{id}/itens": {
      "post": {
        "operationId": "adicionarItem",
        "summary": "Adicionar item ao pedido",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemPedidoRequest"
              },
              "example": {
                "produtoId": 1,
                "quantidade": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Representação atual do pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PedidoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "422": {
            "$ref": "#/components/responses/Erro422"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador do pedido, convertido para Long.",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ]
    },
    "/pedidos/{id}/confirmar": {
      "post": {
        "operationId": "confirmarPedido",
        "summary": "Confirmar pedido",
        "description": "Não recebe corpo. Requer pedido CRIADO com ao menos um item.",
        "responses": {
          "200": {
            "description": "Representação atual do pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PedidoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "422": {
            "$ref": "#/components/responses/Erro422"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador do pedido, convertido para Long.",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "PedidoRequest": {
        "type": "object",
        "required": [
          "clienteId",
          "restauranteId",
          "enderecoEntregaId",
          "itens"
        ],
        "properties": {
          "clienteId": {
            "type": "integer",
            "format": "int64"
          },
          "restauranteId": {
            "type": "integer",
            "format": "int64"
          },
          "enderecoEntregaId": {
            "type": "integer",
            "format": "int64"
          },
          "itens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ItemPedidoRequest"
            }
          },
          "observacao": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "Opcional. Ausência/null: sem observação. Vazio e espaços preservados. Limite validado antes da persistência. O servidor limita a 500 unidades UTF-16 (String.length/Bean Validation); caracteres suplementares ocupam duas unidades."
          }
        }
      },
      "ItemPedidoRequest": {
        "type": "object",
        "required": [
          "produtoId",
          "quantidade"
        ],
        "properties": {
          "produtoId": {
            "type": "integer",
            "format": "int64"
          },
          "quantidade": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ItemResponse": {
        "type": "object",
        "required": [
          "produtoId",
          "nome",
          "quantidade",
          "precoUnitario",
          "subtotal"
        ],
        "properties": {
          "produtoId": {
            "type": "integer",
            "format": "int64"
          },
          "nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "integer"
          },
          "precoUnitario": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "PedidoResponse": {
        "type": "object",
        "required": [
          "id",
          "clienteId",
          "restauranteId",
          "enderecoEntregaId",
          "itens",
          "subtotal",
          "taxaEntrega",
          "valorTotal",
          "distanciaEntregaKm",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "clienteId": {
            "type": "integer",
            "format": "int64"
          },
          "restauranteId": {
            "type": "integer",
            "format": "int64"
          },
          "enderecoEntregaId": {
            "type": "integer",
            "format": "int64"
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            }
          },
          "subtotal": {
            "type": "number"
          },
          "taxaEntrega": {
            "type": "number"
          },
          "valorTotal": {
            "type": "number"
          },
          "distanciaEntregaKm": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string",
            "enum": [
              "CRIADO",
              "CONFIRMADO",
              "PAGO",
              "PAGAMENTO_REJEITADO",
              "EM_ENTREGA",
              "ENTREGUE"
            ]
          },
          "observacao": {
            "type": "string",
            "maxLength": 500,
            "description": "Omitida quando null; caso contrário, texto original, inclusive vazio. Não pode ser editada. O servidor limita a 500 unidades UTF-16 (String.length/Bean Validation); caracteres suplementares ocupam duas unidades."
          }
        }
      },
      "ErroResponse": {
        "type": "object",
        "required": [
          "status",
          "erro",
          "mensagem"
        ],
        "properties": {
          "status": {
            "type": "integer"
          },
          "erro": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Erro400": {
        "description": "Falha de validação do DTO (VALIDATION_ERROR). JSON ilegível ou id não numérico também retorna 400 pelo Spring; nesses casos o corpo não é padronizado por ApiExceptionHandler.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "ErroResponse em erros de Bean Validation; corpo definido pelo framework nos demais erros de entrada."
            },
            "example": {
              "status": 400,
              "erro": "VALIDATION_ERROR",
              "mensagem": "Requisição inválida"
            }
          }
        }
      },
      "Erro404": {
        "description": "Cliente, restaurante, produto ou pedido não encontrado, conforme a operação.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErroResponse"
            },
            "example": {
              "status": 404,
              "erro": "NOT_FOUND",
              "mensagem": "Pedido não encontrado"
            }
          }
        }
      },
      "Erro422": {
        "description": "Regra de negócio violada: endereço, área de atendimento, produto ou estado do pedido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErroResponse"
            },
            "example": {
              "status": 422,
              "erro": "REGRA_NEGOCIO",
              "mensagem": "Apenas pedidos criados podem ser confirmados"
            }
          }
        }
      }
    }
  }
}
